```env
# =========================================
# EmployeeHub - Environment Configuration
# =========================================

# Application
APP_NAME=EmployeeHub
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1


# =========================================
# Database Configuration
# =========================================

DB_HOST=localhost
DB_PORT=5432
DB_NAME=employeehub
DB_USER=employeehub_user
DB_PASSWORD=change_me


# =========================================
# JWT Authentication
# =========================================

JWT_SECRET_KEY=change_this_to_a_strong_secret_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30


# =========================================
# CORS
# =========================================

CORS_ORIGINS=http://localhost:5173


# =========================================
# Frontend
# =========================================

FRONTEND_URL=http://localhost:5173


# =========================================
# Logging
# =========================================

LOG_LEVEL=INFO
```
